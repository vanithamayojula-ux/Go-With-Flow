{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/hero-lab",
      "destination": "/hero-lab.html"
    },
    {
      "source": "/((?!assets|models|hero-lab\\.html|hero-previews|favicon\\.ico|[^/]+\\.(glb|png|jpg|jpeg|webp|svg|mp3|wav|woff2?)).*)",
      "destination": "/index.html"
    }
  ]
}
